  "network_rules": {
    "preferente_discount_extra_pct": 0.05,
    "standard_no_extra_discount_pct": 0.0,
    "out_of_network_penalty_pct": 0.15,
    "emergency_override_message": "Si hay signos de alarma, el agente debe priorizar acudir al servicio de emergencia mas cercano antes de optimizar costos."
  },
  "estimation_rules": {
    "consultation_formula": "gasto = copago fijo del plan en red; fuera de red = max(copago, tarifa_base * (1 - cobertura_fuera_red) + penalidad)",
    "lab_formula": "gasto = tarifa_base * (1 - cobertura_laboratorio_en_red); si deducible pendiente > 0, sumar hasta agotar deducible",
    "imaging_formula": "gasto = tarifa_base * (1 - cobertura_imagenes_en_red); si deducible pendiente > 0, sumar hasta agotar deducible",
    "hospitalization_formula": "gasto = (tarifa_base * dias_estimados) * (1 - cobertura_hospitalaria_en_red) + copago_de_emergencia_si_aplica + deducible_pendiente",
    "demo_simplifications": [
      "No modelar reembolsos diferidos.",
      "No modelar exclusiones clinicas complejas.",
      "No modelar copagos por medico individual.",
      "Limitar la recomendacion a proveedores con especialidad compatible."
    ]
  },
